
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004dcccce86a5c1482796eff603087a5a86'
	option ula_prefix 'fdd0:c556:62a::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'eth0'
	option proto 'static'
	list ipaddr '192.168.110.249/24'
	option ip6assign '60'
	option gateway '192.168.110.1'
	option multipath 'off'
	option force_link '0'
	list dns '223.6.6.6'
	option delegate '0'

config device
	option name 'eth0'
	option ipv6 '0'

